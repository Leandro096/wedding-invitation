---
export interface Props {
  quote: {
    text: string;
    reference: string;
  };
}

const { quote } = Astro.props;
---

<section class="h-dvh quote-mask bg-gradient-to-b from-background to-accent flex items-center justify-center">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center fade-in">
      <!-- Decorative quote mark -->
      <div class="text-6xl md:text-8xl text-secondary opacity-30 font-primary leading-none">"</div>
      
      <!-- Quote text -->
      <blockquote class="text-xl md:text-2xl lg:text-3xl font-primary italic text-primary leading-relaxed mb-6 -mt-4">
        {quote.text}
      </blockquote>
      
      <!-- Bible reference -->
      <cite class="text-lg md:text-xl font-secondary font-semibold text-text not-italic">
        {quote.reference}
      </cite>
      
      <!-- Decorative elements -->
      <div class="mt-8 flex justify-center">
        <div class="w-24 h-px bg-secondary"></div>
        <div class="w-3 h-3 bg-secondary rounded-full mx-4 -mt-1.5"></div>
        <div class="w-24 h-px bg-secondary"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .quote-mask {
    position: relative;
  }

  .quote-mask::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 20%;
    background: linear-gradient(black, transparent);
    pointer-events: none;
  }
</style>